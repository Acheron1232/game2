{
  "name": "@game/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && esbuild src/main.ts src/match/match-worker.ts --bundle --platform=node --format=esm --target=node24 --external:ws --outdir=dist --entry-names=[name]",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "load-test": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@game/shared": "workspace:*",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
