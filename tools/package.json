{
  "name": "@game/tools",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "echo \"tools: nothing to build\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "map:build": "node map/make-map-layout.mjs && node map/bake-terrain.mjs",
    "docs:tables": "node data/fill-doc-tables.mjs",
    "data:check": "tsx data/check-data.ts",
    "art:gen": "tsx art/generate.ts",
    "art:process": "tsx art/process.ts",
    "art:manifest": "tsx art/manifest.ts",
    "models:palette": "tsx models/build-palette.ts",
    "models:build": "tsx models/build.ts",
    "audio:build": "node audio/build-audio.mjs"
  },
  "dependencies": {
    "@game/shared": "workspace:*",
    "sharp": "0.35.5",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@gltf-transform/extensions": "4.5.1"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
