{
  "version": 1,
  "notes": [
    "Settings for the faction AI and for hero bots. Difficulty changes decisions and reaction time, never unit stats or income.",
    "Build order steps run top to bottom. A step starts when the one before it has STARTED (not finished) and the AI can pay for it.",
    "Workers are trained all the time until workerTarget, without being listed in the order.",
    "After the last step the AI goes into 'free play': keeps supply ahead, spends money on its unit mix, rebuilds lost buildings."
  ],

  "faction": {
    "difficulties": {
      "easy": {
        "thinkDelaySec": 1.0, "workerTarget": 12, "maxProductionBuildings": 2,
        "firstAttackArmySupply": 20, "attackArmySupply": 22, "retreatAtArmyPct": 0,
        "expandAtMinute": null, "towersAtBase": 1, "targetChoice": "closest",
        "focusFire": false, "pullWoundedUnits": false, "buildOrderDelaySec": 20
      },
      "normal": {
        "thinkDelaySec": 0.5, "workerTarget": 16, "maxProductionBuildings": 3,
        "firstAttackArmySupply": 24, "attackArmySupply": 28, "retreatAtArmyPct": 30,
        "expandAtMinute": 10, "towersAtBase": 2, "targetChoice": "closest_or_weakest",
        "focusFire": true, "pullWoundedUnits": false, "buildOrderDelaySec": 0
      },
      "hard": {
        "thinkDelaySec": 0.3, "workerTarget": 20, "maxProductionBuildings": 5,
        "firstAttackArmySupply": 22, "attackArmySupply": 34, "retreatAtArmyPct": 40,
        "expandAtMinute": 7, "towersAtBase": 2, "targetChoice": "weakest_or_where_our_hero_fights",
        "focusFire": true, "pullWoundedUnits": true, "buildOrderDelaySec": 0
      }
    },

    "buildOrder": [
      { "do": "build", "what": "house" },
      { "do": "build", "what": "barracks" },
      { "do": "build", "what": "house" },
      { "do": "build", "what": "archery_range" },
      { "do": "train", "what": "swordsman", "count": 2 },
      { "do": "build", "what": "watchtower" },
      { "do": "build", "what": "forge" },
      { "do": "build", "what": "house" },
      { "do": "train", "what": "archer", "count": 3 },
      { "do": "upgrade", "what": "stronghold" },
      { "do": "build", "what": "house" },
      { "do": "build", "what": "chapel" },
      { "do": "build", "what": "workshop" },
      { "do": "expand", "what": "natural", "when": "expandAtMinute reached and natural camp is cleared or our army is strong enough to clear it" },
      { "do": "build", "what": "barracks", "when": "maxProductionBuildings allows" },
      { "do": "upgrade", "what": "citadel" },
      { "do": "build", "what": "hawk_roost" }
    ],

    "unitMix": {
      "notes": "Share of army supply the AI tries to keep, by Town Hall tier. Hero upgrades shift it (see reactions).",
      "tier1": { "swordsman": 0.6, "archer": 0.4 },
      "tier2": { "swordsman": 0.25, "archer": 0.25, "lancer": 0.25, "cleric": 0.15, "catapult": 0.1 },
      "tier3": { "swordsman": 0.15, "archer": 0.2, "lancer": 0.25, "cleric": 0.1, "catapult": 0.1, "hawk_rider": 0.2 }
    },

    "reactions": [
      { "when": "hero bought sharper_blades", "do": "add 0.1 to swordsman and lancer share, take it from archer" },
      { "when": "hero bought better_arrows", "do": "add 0.1 to archer share, take it from swordsman" },
      { "when": "hero bought siege_works", "do": "add 0.05 to catapult share" },
      { "when": "enemy army has many air units", "do": "add 0.15 to archer share" },
      { "when": "base is attacked", "do": "pull the army home if it is closer than the enemy base, and use workers only if the Town Hall is under 30% health" }
    ],

    "attack": {
      "gatherPointDistance": 20,
      "waitForStragglersSec": 15,
      "retargetEverySec": 5,
      "catapultsTarget": "buildings first, towers before other buildings",
      "creepCampsWhenIdle": true
    }
  },

  "heroBot": {
    "difficulties": {
      "easy": { "reactionSec": 0.8, "abilityUseQuality": 0.4, "retreatAtHpPct": 20, "lastHitSkill": 0.3, "joinsAttacks": false },
      "normal": { "reactionSec": 0.4, "abilityUseQuality": 0.7, "retreatAtHpPct": 30, "lastHitSkill": 0.6, "joinsAttacks": true },
      "hard": { "reactionSec": 0.2, "abilityUseQuality": 0.9, "retreatAtHpPct": 35, "lastHitSkill": 0.9, "joinsAttacks": true }
    },
    "campChoice": "Pick the closest camp whose total monster level is at most 4 + 2 x hero level (4 + 3 x hero level when the hero has an ally hero near). Each base has only weak camps close by, so a stricter rule makes bots walk across the map.",
    "shopping": "Buy healing potions when below 2. Then follow the hero's item list (heroBuild below) at the nearest shop when gold allows.",
    "upgrades": "Spend 30% of gold above 300 on Town Hall upgrades, in this order: iron_plates, sharper_blades, better_arrows, rich_veins, stone_walls.",
    "heroBuild": {
      "blood_witch": ["sage_cloak", "mana_stone", "boots_of_haste", "royal_circlet"],
      "staff_warrior": ["thief_band", "swift_gloves", "boots_of_haste", "warblade"],
      "sky_dragon": ["giant_belt", "guard_ring", "boots_of_haste", "ironwood_shield"],
      "stone_golem": ["giant_belt", "guard_ring", "life_pendant", "ironwood_shield"],
      "light_healer": ["mana_stone", "sage_cloak", "boots_of_haste", "royal_circlet"],
      "arcane_huntress": ["thief_band", "iron_claws", "boots_of_haste", "warblade"],
      "centaur_raider": ["giant_belt", "iron_claws", "boots_of_haste", "ironwood_shield"],
      "forest_elf": ["thief_band", "life_pendant", "boots_of_haste", "warblade"]
    }
  }
}
